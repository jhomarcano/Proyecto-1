<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" 
            stylesheets="@styles.css" 
            xmlns="http://javafx.com/javafx" 
            xmlns:fx="http://javafx.com/fxml" 
            fx:controller="co.edu.poli.sw2.controlador.DroneController">

    <!-- ============ BARRA SUPERIOR ============ -->
    <top>
        <VBox spacing="2" styleClass="barra-titulo">
            <Label styleClass="titulo-app" text="Gestion de Drones" />
            <Label styleClass="subtitulo-app" text="Sistema CRUD sobre PostgreSQL  |  Ingenieria de Software 2" />
        </VBox>
    </top>

    <!-- ============ PANEL IZQUIERDO ============ -->
    <left>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="345.0">
            <VBox spacing="14">
                <padding>
                    <Insets bottom="16" left="16" right="16" top="16" />
                </padding>

                <!-- Datos principales -->
                <VBox spacing="9" styleClass="tarjeta">
                    <Label styleClass="titulo-seccion" text="DATOS DEL DRONE" />

                    <Label styleClass="etiqueta-campo" text="Tipo de dron" />
                    <ComboBox fx:id="cmbTipo" maxWidth="Infinity" />

                    <Label styleClass="etiqueta-campo" text="Serial" />
                    <TextField fx:id="txtSerial" promptText="Ej: SN-00123" />

                    <Label styleClass="etiqueta-campo" text="Fabricante" />
                    <TextField fx:id="txtFabricante" promptText="Ej: DJI" />

                    <Label styleClass="etiqueta-campo" text="Modelo" />
                    <TextField fx:id="txtModelo" promptText="Ej: Mavic 3" />

                    <Label styleClass="etiqueta-campo" text="Peso (kg)" />
                    <TextField fx:id="txtPeso" promptText="Ej: 0.9" />

                    <Label fx:id="lblCapacidad" styleClass="etiqueta-campo" text="Capacidad del tanque (L)" />
                    <TextField fx:id="txtCapacidad" promptText="Ej: 10.5" />

                    <CheckBox fx:id="chkDeteccionTermica" text="Deteccion termica" />
                </VBox>

                <!-- Complementos -->
                <VBox spacing="8" styleClass="tarjeta">
                    <Label styleClass="titulo-seccion" text="COMPLEMENTOS" />
                    <CheckBox fx:id="chkBateriaAdicional" text="Bateria adicional (Decorator)" />
                    <TextField fx:id="txtDescripcionBateria" disable="true" promptText="Ej: Bateria LiPo 5000mAh de repuesto" />
                </VBox>

                <!-- Control del Drone -->
                <VBox spacing="8" styleClass="tarjeta">
                    <Label styleClass="titulo-seccion" text="CONTROL DEL DRONE (Bridge)" />
                    <fx:define>
                        <ToggleGroup fx:id="grupoControl" />
                    </fx:define>
                    <RadioButton fx:id="radioSinControl" selected="true" text="Sin control" toggleGroup="$grupoControl" />
                    <RadioButton fx:id="radioControlBasico" text="Control basico" toggleGroup="$grupoControl" />
                    <RadioButton fx:id="radioControlAutonomo" text="Control autonomo" toggleGroup="$grupoControl" />
                </VBox>

                <!-- Patrones de Diseño -->
                <VBox spacing="10" styleClass="tarjeta">
                    <Label styleClass="titulo-seccion" text="PATRONES DE DISENO" />
                    <VBox spacing="8">
                        <Button fx:id="btnAleatorio" maxWidth="Infinity" onAction="#generarVigilanciaAleatoria" styleClass="boton,boton-patron" text="Generar Vigilancia (Builder)" />
                        <Button fx:id="btnClonar" maxWidth="Infinity" onAction="#clonarDrone" styleClass="boton,boton-patron" text="Clonar drone (Prototype)" />
                        <Button fx:id="btnComposite" maxWidth="Infinity" onAction="#mostrarComposite" styleClass="boton,boton-patron" text="Ver jerarquia de sensores (Composite)" />
                        <Button fx:id="btnExportarMision" maxWidth="Infinity" onAction="#exportarMisionJson" styleClass="boton,boton-patron" text="Exportar Mision (Adapter)" />
                    </VBox>
                </VBox>
                <!-- Mensaje de Error/Estado -->
                <Label fx:id="lblMensaje" styleClass="mensaje-error" wrapText="true" />

                <!-- Operaciones -->
                <VBox spacing="10" styleClass="tarjeta">
                    <Label styleClass="titulo-seccion" text="OPERACIONES" />
                    <GridPane hgap="9" maxWidth="Infinity" vgap="9">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                        </columnConstraints>

                        <Button fx:id="btnAgregar" maxWidth="Infinity" onAction="#agregarDrone" styleClass="boton,boton-primario" text="Agregar" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <Button fx:id="btnModificar" maxWidth="Infinity" onAction="#modificarDrone" styleClass="boton,boton-secundario" text="Modificar" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Button fx:id="btnEliminar" maxWidth="Infinity" onAction="#eliminarDrone" styleClass="boton,boton-peligro" text="Eliminar" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <Button fx:id="btnLimpiar" maxWidth="Infinity" onAction="#limpiarFormulario" styleClass="boton,boton-neutro" text="Limpiar" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    </GridPane>
                </VBox>

            </VBox>
        </ScrollPane>
    </left>

    <!-- ============ TABLA CENTRAL ============ -->
    <center>
        <VBox spacing="10" styleClass="tarjeta">
            <BorderPane.margin>
                <Insets bottom="16" left="0" right="16" top="16" />
            </BorderPane.margin>

            <Label styleClass="titulo-seccion" text="DRONES REGISTRADOS" />

            <TableView fx:id="tablaDrones" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                    <TableColumn fx:id="colTipo" prefWidth="115.0" text="Tipo" />
                    <TableColumn fx:id="colSerial" prefWidth="110.0" text="Serial" />
                    <TableColumn fx:id="colFabricante" prefWidth="115.0" text="Fabricante" />
                    <TableColumn fx:id="colModelo" prefWidth="110.0" text="Modelo" />
                    <TableColumn fx:id="colPeso" prefWidth="85.0" text="Peso (kg)" />
                    <TableColumn fx:id="colEspecifico" prefWidth="150.0" text="Atributo especifico" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <placeholder>
                    <Label text="No hay drones registrados todavia." />
                </placeholder>
            </TableView>
        </VBox>
    </center>

</BorderPane>