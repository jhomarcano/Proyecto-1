<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.poli.sw2.controlador.DroneController"
            stylesheets="@styles.css"
            prefHeight="700.0" prefWidth="1100.0">

    <!-- ============ BARRA SUPERIOR ============ -->
    <top>
        <VBox styleClass="barra-titulo" spacing="2">
            <Label text="Gestion de Drones" styleClass="titulo-app"/>
            <Label text="Sistema CRUD sobre PostgreSQL  |  Ingenieria de Software 2"
                   styleClass="subtitulo-app"/>
        </VBox>
    </top>

    <!-- ============ PANEL IZQUIERDO ============ -->
    <left>
        <ScrollPane fitToWidth="true" prefWidth="345.0" hbarPolicy="NEVER">
            <VBox spacing="14">
                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>


                <VBox spacing="9" styleClass="tarjeta">
                    <Label text="DATOS DEL DRONE" styleClass="titulo-seccion"/>

                    <Label text="Tipo de dron" styleClass="etiqueta-campo"/>
                    <ComboBox fx:id="cmbTipo" maxWidth="Infinity"/>

                    <Label text="Serial" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtSerial" promptText="Ej: SN-00123"/>

                    <Label text="Fabricante" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtFabricante" promptText="Ej: DJI"/>

                    <Label text="Modelo" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtModelo" promptText="Ej: Mavic 3"/>

                    <Label text="Peso (kg)" styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtPeso" promptText="Ej: 0.9"/>

                    <Label fx:id="lblCapacidad" text="Capacidad del tanque (L)"
                           styleClass="etiqueta-campo"/>
                    <TextField fx:id="txtCapacidad" promptText="Ej: 10.5"/>

                    <CheckBox fx:id="chkDeteccionTermica" text="Deteccion termica"/>
                </VBox>


                <VBox spacing="8" styleClass="tarjeta">
                    <Label text="COMPLEMENTOS" styleClass="titulo-seccion"/>
                    <CheckBox fx:id="chkBateriaAdicional" text="Bateria adicional (Decorator)"/>
                    <TextField fx:id="txtDescripcionBateria"
                               promptText="Ej: Bateria LiPo 5000mAh de repuesto"
                               disable="true"/>
                </VBox>


                <VBox spacing="10" styleClass="tarjeta">
                    <Label text="OPERACIONES" styleClass="titulo-seccion"/>

                    <FlowPane hgap="9" vgap="9" prefWrapLength="280.0">
                    <GridPane hgap="9" vgap="9" maxWidth="Infinity">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Button fx:id="btnAgregar" text="Agregar"
                                onAction="#agregarDrone" maxWidth="Infinity"
                                styleClass="boton,boton-primario"
                                GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Button fx:id="btnModificar" text="Modificar"
                                onAction="#modificarDrone" maxWidth="Infinity"
                                styleClass="boton,boton-secundario"
                                GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Button fx:id="btnEliminar" text="Eliminar"
                                onAction="#eliminarDrone" maxWidth="Infinity"
                                styleClass="boton,boton-peligro"
                                GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Button fx:id="btnLimpiar" text="Limpiar"
                                onAction="#limpiarFormulario" maxWidth="Infinity"
                                styleClass="boton,boton-neutro"
                                GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    </GridPane>
                    </FlowPane>
                </VBox>

   
                <VBox spacing="10" styleClass="tarjeta">
                    <Label text="PATRONES DE DISENO" styleClass="titulo-seccion"/>

                    <VBox spacing="8">
                        <Button fx:id="btnAleatorio" text="Generar Vigilancia (Builder)"
                                onAction="#generarVigilanciaAleatoria"
                                maxWidth="Infinity" styleClass="boton,boton-patron"/>
                        <Button fx:id="btnClonar" text="Clonar drone (Prototype)"
                                onAction="#clonarDrone"
                                maxWidth="Infinity" styleClass="boton,boton-patron"/>
                    </VBox>
                </VBox>

                <Label fx:id="lblMensaje" wrapText="true" styleClass="mensaje-error"/>
                
                
                            <VBox spacing="8" styleClass="tarjeta">
    <Label text="CONTROL DEL DRONE (Bridge)" styleClass="titulo-seccion"/>
    <fx:define>
        <ToggleGroup fx:id="grupoControl"/>
    </fx:define>
    <RadioButton fx:id="radioSinControl" text="Sin control" toggleGroup="$grupoControl" selected="true"/>
    <RadioButton fx:id="radioControlBasico" text="Control basico" toggleGroup="$grupoControl"/>
    <RadioButton fx:id="radioControlAutonomo" text="Control autonomo" toggleGroup="$grupoControl"/>
</VBox>

            </VBox>
            
        </ScrollPane>
    </left>

    <!-- ============ TABLA ============ -->
    <center>
        <VBox spacing="10" styleClass="tarjeta">
            <BorderPane.margin><Insets top="16" right="16" bottom="16" left="0"/></BorderPane.margin>

            <Label text="DRONES REGISTRADOS" styleClass="titulo-seccion"/>

            <TableView fx:id="tablaDrones" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50.0"/>
                    <TableColumn fx:id="colTipo" text="Tipo" prefWidth="115.0"/>
                    <TableColumn fx:id="colSerial" text="Serial" prefWidth="110.0"/>
                    <TableColumn fx:id="colFabricante" text="Fabricante" prefWidth="115.0"/>
                    <TableColumn fx:id="colModelo" text="Modelo" prefWidth="110.0"/>
                    <TableColumn fx:id="colPeso" text="Peso (kg)" prefWidth="85.0"/>
                    <TableColumn fx:id="colEspecifico" text="Atributo especifico" prefWidth="150.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="No hay drones registrados todavia."/>
                </placeholder>
            </TableView>
        </VBox>
    </center>

</BorderPane>